# OpenAI
# Required only for explicitly enabled live/provider runtime use. Never commit a real key.
OPENAI_API_KEY=
OPENAI_TIMEOUT_SECONDS=180
OPENAI_MAX_OUTPUT_TOKENS=48000
RUN_OPENAI_LIVE_TESTS=0
OPENAI_DRAFT_TIMEOUT_SECONDS=240
OPENAI_DRAFT_MAX_OUTPUT_TOKENS=64000
RUN_OPENAI_DRAFT_LIVE_TESTS=0

# Process environment only; backend does not automatically load this file.
# Next server-side rewrite target (not a NEXT_PUBLIC_* browser variable).
BACKEND_URL=http://127.0.0.1:8000
# Optional backend upload directory outside the repository; blank uses OS temp.
# AI_IP_UPLOAD_ROOT=
# Local single-tenant orchestration only. This is not authentication; normal
# processing with this flag enabled uses provider runtimes. Offline E2E injects fakes.
AI_IP_ENABLE_LOCAL_ORCHESTRATION_API=0
