{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/supported-draft-claims/v1.0.0/supported-draft-claims.schema.json",
  "title": "SUPPORTED_DRAFT_CLAIMS v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "output_type",
    "claims_draft_id",
    "status",
    "source_identity",
    "generation_config",
    "claim_families",
    "claims",
    "review_package",
    "review_boundary"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "output_type": { "const": "SUPPORTED_DRAFT_CLAIMS" },
    "claims_draft_id": { "type": "string", "pattern": "^p2-004-[0-9a-f]{24}$" },
    "status": { "enum": ["PRESENT", "PARTIAL_REVIEW_REQUIRED", "HUMAN_CONFIRMATION_REQUIRED"] },
    "source_identity": { "$ref": "#/$defs/source_identity" },
    "generation_config": { "$ref": "#/$defs/generation_config" },
    "claim_families": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/family" } },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "review_package": { "$ref": "#/$defs/review_package" },
    "review_boundary": { "$ref": "#/$defs/review_boundary" }
  },
  "$defs": {
    "non_empty_text": { "type": "string", "minLength": 1 },
    "identifier": { "type": "string", "minLength": 1 },
    "identifier_array": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
    "pointer_array": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^/" } },
    "claim_type": { "enum": ["SYSTEM", "APPARATUS", "METHOD", "PROCESS", "COMPOSITION"] },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "file_name", "media_type", "source_document_synthetic", "p2_002_identity", "p2_003_draft_id", "p2_003_content_sha256"],
      "properties": {
        "document_id": { "$ref": "#/$defs/identifier" },
        "file_name": { "$ref": "#/$defs/non_empty_text" },
        "media_type": { "$ref": "#/$defs/non_empty_text" },
        "source_document_synthetic": { "const": true },
        "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "p2_002_identity": { "type": "string", "pattern": "^p2-002-sha256-[0-9a-f]{64}$" },
        "p2_003_draft_id": { "type": "string", "pattern": "^p2-003-[0-9a-f]{24}$" },
        "p2_003_content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "p2_003_generation_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "abstract_max_words", "include_claims", "target_jurisdiction", "source_document_synthetic"],
      "properties": {
        "language": { "const": "en" },
        "abstract_max_words": { "const": 150 },
        "include_claims": { "const": false },
        "target_jurisdiction": { "const": "US" },
        "source_document_synthetic": { "const": true },
        "selected_title_candidate_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "generation_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "target_jurisdiction", "requested_claim_types", "max_dependent_claims_per_family", "source_document_synthetic", "selected_solution_id", "p2_003_generation_config"],
      "properties": {
        "language": { "const": "en" },
        "target_jurisdiction": { "const": "US" },
        "requested_claim_types": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/claim_type" } },
        "max_dependent_claims_per_family": { "type": "integer", "minimum": 0, "maximum": 10 },
        "source_document_synthetic": { "const": true },
        "selected_solution_id": { "$ref": "#/$defs/identifier" },
        "p2_003_generation_config": { "$ref": "#/$defs/p2_003_generation_config" }
      }
    },
    "support_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_paths", "evidence_ids", "specification_section_ids", "issue_ids"],
      "properties": {
        "source_paths": { "$ref": "#/$defs/pointer_array" },
        "evidence_ids": { "$ref": "#/$defs/identifier_array" },
        "specification_section_ids": { "$ref": "#/$defs/identifier_array" },
        "issue_ids": { "$ref": "#/$defs/identifier_array" }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_family_id", "claim_type", "selected_solution_id", "independent_claim_number", "dependent_claim_numbers", "status", "support_summary", "review_status"],
      "properties": {
        "claim_family_id": { "type": "string", "pattern": "^CF-P2-004-(SYSTEM|APPARATUS|METHOD|PROCESS|COMPOSITION)$" },
        "claim_type": { "$ref": "#/$defs/claim_type" },
        "selected_solution_id": { "$ref": "#/$defs/identifier" },
        "independent_claim_number": { "type": ["integer", "null"], "minimum": 1 },
        "dependent_claim_numbers": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
        "status": { "enum": ["PRESENT", "HUMAN_CONFIRMATION_REQUIRED", "NOT_GENERATED"] },
        "support_summary": { "$ref": "#/$defs/support_summary" },
        "review_status": { "const": "UNREVIEWED" }
      }
    },
    "disclosure_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "paragraph_id", "specification_path", "reconstruction_path", "evidence_ids"],
      "properties": {
        "section_id": { "$ref": "#/$defs/identifier" },
        "paragraph_id": { "$ref": "#/$defs/identifier" },
        "specification_path": { "type": "string", "pattern": "^/" },
        "reconstruction_path": { "type": "string", "pattern": "^/" },
        "evidence_ids": { "$ref": "#/$defs/identifier_array" }
      }
    },
    "claim_element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element_id", "sequence", "text", "element_role", "source_paths", "evidence_ids", "specification_section_ids", "specification_support_refs", "grounding", "support_status", "upstream_entity_ids", "essentiality", "inherited_from_element_id"],
      "properties": {
        "element_id": { "type": "string", "pattern": "^CE-P2-004-[0-9]{4,}$" },
        "sequence": { "type": "integer", "minimum": 1 },
        "text": { "$ref": "#/$defs/non_empty_text" },
        "element_role": { "enum": ["ENTITY", "RELATIONSHIP", "PARAMETER", "CONDITIONAL_UNIT", "EMBODIMENT", "VARIANT"] },
        "source_paths": { "allOf": [{ "$ref": "#/$defs/pointer_array" }, { "minItems": 1 }] },
        "evidence_ids": { "allOf": [{ "$ref": "#/$defs/identifier_array" }, { "minItems": 1 }] },
        "specification_section_ids": { "allOf": [{ "$ref": "#/$defs/identifier_array" }, { "minItems": 1 }] },
        "specification_support_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/disclosure_ref" } },
        "grounding": { "enum": ["SOURCE_FACT", "PARAPHRASE"] },
        "support_status": { "const": "SUPPORTED" },
        "upstream_entity_ids": { "allOf": [{ "$ref": "#/$defs/identifier_array" }, { "minItems": 1 }] },
        "essentiality": { "enum": ["ESSENTIAL", "OPTIONAL", "CONDITIONAL", "NOT_APPLICABLE"] },
        "inherited_from_element_id": { "type": ["string", "null"], "pattern": "^CE-P2-004-[0-9]{4,}$" },
        "parameter_scope": { "enum": ["EXAMPLE_ONLY", "SUPPORTED_RANGE", "UNKNOWN_SCOPE"] },
        "relationship_type": { "enum": ["RELATED_TO", "PART_OF", "CONTAINS", "CONNECTED_TO", "COUPLED_TO", "COMMUNICATES_WITH", "RECEIVES_FROM", "OUTPUTS_TO", "CONTROLS", "TRANSFORMS", "MEASURES", "STORES", "EXECUTES", "INPUT_TO_STEP", "OUTPUT_FROM_STEP", "DEPENDS_ON"] }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_number", "claim_type", "independent_or_dependent", "depends_on", "claim_text", "claim_elements", "claim_family_id", "review_status"],
      "properties": {
        "claim_number": { "type": "integer", "minimum": 1 },
        "claim_type": { "$ref": "#/$defs/claim_type" },
        "independent_or_dependent": { "enum": ["INDEPENDENT", "DEPENDENT"] },
        "depends_on": { "type": "array", "maxItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
        "claim_text": { "$ref": "#/$defs/non_empty_text" },
        "claim_elements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claim_element" } },
        "claim_family_id": { "type": "string", "pattern": "^CF-P2-004-(SYSTEM|APPARATUS|METHOD|PROCESS|COMPOSITION)$" },
        "review_status": { "const": "UNREVIEWED" }
      }
    },
    "claim_support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_number", "element_id", "support_status", "source_paths", "evidence_ids", "specification_section_ids", "specification_support_refs", "upstream_entity_ids", "grounding", "conflict_status"],
      "properties": {
        "claim_number": { "type": "integer", "minimum": 1 },
        "element_id": { "type": "string", "pattern": "^CE-P2-004-[0-9]{4,}$" },
        "support_status": { "const": "SUPPORTED" },
        "source_paths": { "allOf": [{ "$ref": "#/$defs/pointer_array" }, { "minItems": 1 }] },
        "evidence_ids": { "allOf": [{ "$ref": "#/$defs/identifier_array" }, { "minItems": 1 }] },
        "specification_section_ids": { "allOf": [{ "$ref": "#/$defs/identifier_array" }, { "minItems": 1 }] },
        "specification_support_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/disclosure_ref" } },
        "upstream_entity_ids": { "allOf": [{ "$ref": "#/$defs/identifier_array" }, { "minItems": 1 }] },
        "grounding": { "enum": ["SOURCE_FACT", "PARAPHRASE"] },
        "conflict_status": { "const": "CLEAR" },
        "parameter_scope": { "enum": ["EXAMPLE_ONLY", "SUPPORTED_RANGE", "UNKNOWN_SCOPE"] }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_id", "code", "family_id", "entity_ids", "source_paths", "specification_paths", "evidence_ids", "missing_ids", "author_question_ids", "support_status", "message"],
      "properties": {
        "issue_id": { "type": "string", "pattern": "^ISS-P2-004-[0-9]{4,}$" },
        "code": { "$ref": "#/$defs/identifier" },
        "family_id": { "type": "string", "pattern": "^CF-P2-004-(SYSTEM|APPARATUS|METHOD|PROCESS|COMPOSITION)$" },
        "entity_ids": { "$ref": "#/$defs/identifier_array" },
        "source_paths": { "$ref": "#/$defs/pointer_array" },
        "specification_paths": { "$ref": "#/$defs/pointer_array" },
        "evidence_ids": { "$ref": "#/$defs/identifier_array" },
        "missing_ids": { "$ref": "#/$defs/identifier_array" },
        "author_question_ids": { "$ref": "#/$defs/identifier_array" },
        "support_status": { "enum": ["UNSUPPORTED", "HUMAN_CONFIRMATION_REQUIRED"] },
        "message": { "$ref": "#/$defs/non_empty_text" }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warning_id", "code", "family_id", "affected_ids", "source_paths", "message"],
      "properties": {
        "warning_id": { "type": "string", "pattern": "^W-P2-004-[0-9]{4,}$" },
        "code": { "$ref": "#/$defs/identifier" },
        "family_id": { "type": "string", "pattern": "^CF-P2-004-(SYSTEM|APPARATUS|METHOD|PROCESS|COMPOSITION)$" },
        "affected_ids": { "$ref": "#/$defs/identifier_array" },
        "source_paths": { "$ref": "#/$defs/pointer_array" },
        "message": { "$ref": "#/$defs/non_empty_text" }
      }
    },
    "missing_information": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missing_id", "family_id", "source_paths", "reason", "question_ids"],
      "properties": {
        "missing_id": { "type": "string", "pattern": "^MI-P2-004-[0-9]{4,}$" },
        "family_id": { "type": "string", "pattern": "^CF-P2-004-(SYSTEM|APPARATUS|METHOD|PROCESS|COMPOSITION)$" },
        "source_paths": { "$ref": "#/$defs/pointer_array" },
        "reason": { "$ref": "#/$defs/non_empty_text" },
        "question_ids": { "$ref": "#/$defs/identifier_array" }
      }
    },
    "author_question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "family_id", "missing_id", "question", "status"],
      "properties": {
        "question_id": { "type": "string", "pattern": "^AQ-P2-004-[0-9]{4,}$" },
        "family_id": { "type": "string", "pattern": "^CF-P2-004-(SYSTEM|APPARATUS|METHOD|PROCESS|COMPOSITION)$" },
        "missing_id": { "type": "string", "pattern": "^MI-P2-004-[0-9]{4,}$" },
        "question": { "$ref": "#/$defs/non_empty_text" },
        "status": { "const": "OPEN" }
      }
    },
    "evidence_locator": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "section": { "$ref": "#/$defs/non_empty_text" },
        "paragraph_id": { "$ref": "#/$defs/identifier" },
        "chunk_id": { "$ref": "#/$defs/identifier" },
        "table_id": { "$ref": "#/$defs/identifier" },
        "figure_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "document_id", "evidence_type", "locator", "excerpt"],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/identifier" },
        "document_id": { "$ref": "#/$defs/identifier" },
        "evidence_type": { "enum": ["TEXT", "TABLE"] },
        "locator": { "$ref": "#/$defs/evidence_locator" },
        "excerpt": { "$ref": "#/$defs/non_empty_text" }
      }
    },
    "review_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "claim_support", "issues", "warnings", "missing_information", "author_questions"],
      "properties": {
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "claim_support": { "type": "array", "items": { "$ref": "#/$defs/claim_support" } },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } },
        "missing_information": { "type": "array", "items": { "$ref": "#/$defs/missing_information" } },
        "author_questions": { "type": "array", "items": { "$ref": "#/$defs/author_question" } }
      }
    },
    "review_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_grounded", "human_ip_review_required", "review_status", "filing_ready", "legal_advice", "patentability_assessment_included", "novelty_assessment_included", "claim_scope_optimized", "assembled_p2_001_document", "render_review_metadata_as_claim_text"],
      "properties": {
        "status": { "const": "DRAFT" },
        "source_grounded": { "const": true },
        "human_ip_review_required": { "const": true },
        "review_status": { "const": "UNREVIEWED" },
        "filing_ready": { "const": false },
        "legal_advice": { "const": false },
        "patentability_assessment_included": { "const": false },
        "novelty_assessment_included": { "const": false },
        "claim_scope_optimized": { "const": false },
        "assembled_p2_001_document": { "const": false },
        "render_review_metadata_as_claim_text": { "const": false }
      }
    }
  }
}
