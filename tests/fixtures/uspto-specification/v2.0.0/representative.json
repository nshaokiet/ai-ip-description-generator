  "abstract": {
    "section_id": "ABSTRACT_OF_THE_DISCLOSURE",
    "sequence": 12,
    "heading": "ABSTRACT OF THE DISCLOSURE",
    "status": "PRESENT",
    "text": "A synthetic distributed monitoring system receives readings and sample identifiers from sensor nodes. A monitoring coordinator evaluates each reading against a threshold and stores an alert record that identifies a contributing sample when the threshold condition is satisfied. The record preserves traceability between the alert and synthetic source data.",
