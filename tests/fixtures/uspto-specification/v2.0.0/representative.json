      "section_id": "BRIEF_SUMMARY_OF_THE_INVENTION",
      "sequence": 8,
      "heading": "BRIEF SUMMARY OF THE INVENTION",
      "status": "PRESENT",
      "paragraphs": [
        {
          "paragraph_id": "P-SUMMARY-001",
          "sequence": 1,
          "text": "A monitoring coordinator receives synthetic sensor samples, evaluates a threshold rule, and records an alert together with identifiers for the samples that contributed to the alert.",
