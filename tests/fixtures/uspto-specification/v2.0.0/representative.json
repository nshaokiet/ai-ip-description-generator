    {
      "section_id": "DETAILED_DESCRIPTION_OF_THE_INVENTION",
      "sequence": 10,
      "heading": "DETAILED DESCRIPTION OF THE INVENTION",
      "status": "PRESENT",
      "paragraphs": [
        {
          "paragraph_id": "P-DETAIL-001",
          "sequence": 1,
          "text": "Referring to FIG. 1, the monitoring system 100 includes sensor nodes 110 and a monitoring coordinator 120. Each sensor node 110 provides a synthetic reading and a sample identifier to the monitoring coordinator 120.",
          "support": {
            "source_paths": [
              "/sections/2",
              "/figures/0"
            ],
            "evidence_ids": [
              "EV-SOURCE-METHOD",
              "EV-SOURCE-FIGURE"
            ],
            "grounding_class": "PARAPHRASE"
          }
        },
        {
          "paragraph_id": "P-DETAIL-002",
          "sequence": 2,
          "text": "The monitoring coordinator 120 compares a received synthetic reading with a stored threshold and, when the threshold condition is satisfied, stores an alert record containing the contributing sample identifier.",
          "support": {
            "source_paths": [
              "/sections/3"
            ],
            "evidence_ids": [
              "EV-SOURCE-METHOD"
            ],
            "grounding_class": "SOURCE_FACT"
          }
        },
        {
          "paragraph_id": "P-DETAIL-003",
          "sequence": 3,
          "text": "The alert record further stores a timestamp associated with the synthetic reading.",
          "support": {
            "source_paths": [
              "/sections/3/paragraphs/2"
            ],
            "evidence_ids": [
              "EV-SOURCE-TIMESTAMP"
            ],
            "grounding_class": "SOURCE_FACT"
          }
        }
      ],
