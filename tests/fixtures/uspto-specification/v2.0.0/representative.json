          "status": "PRESENT",
          "paragraphs": [
            {
              "paragraph_id": "P-RELATED-001",
              "sequence": 1,
              "text": "Conventional test monitors may evaluate readings independently and may not preserve a traceable relationship between an alert and the contributing sensor samples.",
